/* The sentence a person reads when the system asks for a permission. The system localises
   its own half — the title and the buttons — and shows THIS half exactly as written, so a
   phrase without a translation reaches every language unchanged. The source is English
   (Info.plist); this file is one language of it. */

"NSBluetoothAlwaysUsageDescription" = "Montana uses Bluetooth to form a direct device-to-device mesh, so your phones can exchange messages nearby.";
"NSCameraUsageDescription" = "Montana uses the camera to take photos and videos for your chats.";
"NSContactsUsageDescription" = "MT Business uses your contacts to show which of them are already here, checking their numbers against the directory as hashes, to share a contact in a chat, and to save the people you add to your contacts by their @name. Turn this off in Settings, Privacy, Sync contacts.";
"NSFaceIDUsageDescription" = "Montana uses Face ID to open your saved passwords and to show your 24-word recovery phrase.";
"NSLocalNetworkUsageDescription" = "Montana connects your device and your correspondent's directly over Wi-Fi. The permission is needed only so the phones can find each other on the same network.";
"NSLocationWhenInUseUsageDescription" = "MT Business uses your location so you can send it in a chat. If a work chat asks for its people's location and you allow it, your location is sent to that chat's managers while you are a member — also in the background, with the location indicator shown, and by itself once in each reporting window. You can stop it at any time on the chat's page.";
"NSMicrophoneUsageDescription" = "Montana uses the microphone to record voice messages, videos and calls.";
"NSSpeechRecognitionUsageDescription" = "Montana turns an order you dictate into text on this device only; the sound never leaves the phone.";
"NSPhotoLibraryAddUsageDescription" = "Montana saves photos from your chats to your library.";
"NSPhotoLibraryUsageDescription" = "Montana shows your recent photos and videos so you can send one quickly.";

/* The name iCloud gives this app's storage (NSUbiquitousContainers in Info.plist). The iCloud
   daemon keeps that name per language and takes each language's name from THIS file only (read
   in its own code, 23.09): without this line the container carried a name in no language at all,
   while Apple's storage page called it "app", the tail of the container's identifier. The
   product's name is one word in every language. */
"NSUbiquitousContainerName" = "Montana Business";

/* The name under the icon (CFBundleDisplayName in Info.plist): the short name the author gave, MT Business, in every language (06.10). */
"CFBundleDisplayName" = "MT Business";
